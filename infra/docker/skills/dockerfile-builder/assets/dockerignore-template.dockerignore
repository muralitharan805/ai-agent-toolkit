# ==============================================================================
# Production .dockerignore Template
# Excludes local developer dependencies, credentials, tests, and build artifacts
# ==============================================================================

.git
.gitignore
.gitattributes

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local Package Dependencies & Caches
node_modules
.pnpm-store
.npm
.yarn

# Build Outputs & Temporary Artifacts
dist
build
coverage
*.tsbuildinfo

# IDE & OS Artifacts
.vscode
.idea
.DS_Store
Thumbs.db

# Documentation & Logs
README.md
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
