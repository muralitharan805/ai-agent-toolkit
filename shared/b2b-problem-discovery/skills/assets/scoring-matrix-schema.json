{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProblemCandidateEvaluationPayload",
  "description": "JSON schema for validating 35-point problem candidate scoring and stop-check evaluation inputs.",
  "type": "object",
  "required": ["id", "scores", "stop_checks"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique candidate identifier (e.g. PROB-20260906-31PTS-CAM-RECONCILIATION)."
    },
    "domain": {
      "type": "string",
      "description": "Target domain vertical (e.g. Accounting, Logistics, Real Estate)."
    },
    "scores": {
      "type": "object",
      "required": [
        "frequency",
        "consequence_wtp",
        "workaround_strength",
        "evidence_quality",
        "segment_reach",
        "alternative_gap",
        "access_to_validation"
      ],
      "properties": {
        "frequency": { "type": "integer", "enum": [1, 3, 5] },
        "consequence_wtp": { "type": "integer", "enum": [1, 3, 5] },
        "workaround_strength": { "type": "integer", "enum": [1, 3, 5] },
        "evidence_quality": { "type": "integer", "enum": [1, 3, 5] },
        "segment_reach": { "type": "integer", "enum": [1, 3, 5] },
        "alternative_gap": { "type": "integer", "enum": [1, 3, 5] },
        "access_to_validation": { "type": "integer", "enum": [1, 3, 5] }
      },
      "additionalProperties": false
    },
    "stop_checks": {
      "type": "object",
      "required": [
        "infrequent_low_impact",
        "no_meaningful_workaround",
        "commercial_alternative_fits_well",
        "single_source_bias",
        "internal_training_issue",
        "unreachable_audience"
      ],
      "properties": {
        "infrequent_low_impact": { "type": "boolean" },
        "no_meaningful_workaround": { "type": "boolean" },
        "commercial_alternative_fits_well": { "type": "boolean" },
        "single_source_bias": { "type": "boolean" },
        "internal_training_issue": { "type": "boolean" },
        "unreachable_audience": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
