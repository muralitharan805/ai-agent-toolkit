# ==============================================================================
# Production Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions for New Developers:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Update the values with your local development configuration.
# 3. NEVER commit your local '.env' file to version control.
# ==============================================================================

# ==============================================================================
# HTTP Server Port
# Purpose: The local TCP network port the application server listens on
# Format: Positive integer (1024 - 65535)
# Local Default: 3000
# ==============================================================================
PORT=3000

# ==============================================================================
# Application Runtime Environment
# Purpose: Governs error verbosity, security controls, and log levels
# Allowed Values: development | test | staging | production
# Local Default: development
# ==============================================================================
APP_ENV=development

# ==============================================================================
# Application Log Verbosity Level
# Purpose: Controls the threshold for emitted structured log entries
# Allowed Values: debug | info | warn | error
# Local Default: info
# ==============================================================================
LOG_LEVEL=info

# ==============================================================================
# Primary Database Connection URI
# Purpose: Connects to the application persistence store (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
# Local Source: Start local database using 'docker-compose up -d postgres'
# ==============================================================================
DATABASE_URL="postgresql://postgres:postgres_local_password@localhost:5432/myapp_dev?schema=public"

# ==============================================================================
# JWT Authentication Secret Key
# Purpose: Cryptographic key used to sign and verify stateless JWT tokens
# Format: Minimum 32-character high-entropy base64 or alphanumeric string
# Generation: Run 'openssl rand -base64 32' in your terminal
# ==============================================================================
JWT_SECRET="replace_with_32_character_minimum_cryptographic_secret_key"

# ==============================================================================
# JWT Access Token Expiration Term
# Purpose: Time window before an access token expires and requires refresh
# Format: Duration string (e.g. 15m, 1h)
# ==============================================================================
JWT_EXPIRES_IN="15m"

# ==============================================================================
# JWT Refresh Token Expiration Term
# Purpose: Maximum session lifespan for rotating refresh token cookies
# Format: Duration string (e.g. 7d, 30d)
# ==============================================================================
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================================================================
# Redis Cache & In-Memory Store URI
# Purpose: Used for distributed caching, session state, and rate limiting
# Format: redis://[user]:[password]@[host]:[port]
# Local Source: Start local Redis using 'docker-compose up -d redis'
# ==============================================================================
REDIS_URL="redis://localhost:6379"
