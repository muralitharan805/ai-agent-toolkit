{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentContextPackSchema",
  "description": "Validation schema for bounded Dynamic Context Packs assembled from persisted discovery state.",
  "type": "object",
  "required": ["schema_version", "task", "assembled_at", "deterministic_summary", "constraints"],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0"] },
    "task": {
      "type": "string",
      "enum": ["PROBLEM_EVALUATION", "EXPERIMENT_VALIDATION", "SOLUTION_STRATEGY", "DISCOVERY_QUERY"]
    },
    "assembled_at": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["DESIGN", "ASSESS"] },
    "query": { "type": "string" },
    "research_run": { "type": "object" },
    "research_plan": { "type": "object" },
    "candidate": { "type": "object" },
    "evaluation": { "type": "object" },
    "validation_scope": { "type": "object" },
    "experiment_contract": { "type": "object" },
    "experiments_summary": { "type": "object" },
    "signals": { "type": "array", "items": { "type": "object" } },
    "matches": { "type": "array", "items": { "type": "object" } },
    "search_hits": { "type": "array", "items": { "type": "object" } },
    "deterministic_summary": {
      "type": "object",
      "required": ["total_signals"],
      "properties": {
        "total_signals": { "type": "integer", "minimum": 0 },
        "platform_breakdown": { "type": "object" },
        "evidence_level_distribution": { "type": "object" },
        "existing_candidate_matches": { "type": "array" },
        "prior_experiments_count": { "type": "integer", "minimum": 0 },
        "matched_candidates": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "constraints": { "type": "object" }
  },
  "additionalProperties": true
}
