{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentskills.io/schemas/problem-discovery/scoring-matrix.schema.json",
  "title": "ProblemDiscoveryCandidateSchema",
  "description": "JSON Schema modeling grounded problem candidate evaluations, dual-track prioritization scores, evidence verification, and smallest suitable solutions.",
  "type": "object",
  "required": [
    "id",
    "title",
    "domain",
    "track",
    "validation_status",
    "evidence_level",
    "scores",
    "stop_checks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PROB-[A-Za-z0-9_-]+$",
      "description": "Unique identifier for the problem candidate dossier."
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 120,
      "description": "Concise, descriptive title of the operational failure point."
    },
    "domain": {
      "type": "string",
      "description": "Industry vertical or technical domain (e.g., Construction, Developer Tools, Local Retail)."
    },
    "track": {
      "type": "string",
      "enum": ["commercial", "free_utility"],
      "default": "commercial",
      "description": "Evaluation track: Commercial (SaaS/WTP) or Free Utility (Public benefit / Civic / Offline)."
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "unverified",
        "research_priority",
        "corroborated",
        "experiment_validated",
        "parked",
        "rejected"
      ],
      "description": "Empirical validation status based on observed evidence and experiment outcomes."
    },
    "priority_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 35,
      "description": "35-Point Research Prioritization Score (measure of research priority, NOT market proof)."
    },
    "evidence_level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Evidence Quality Ladder level: 1 (Primary Behavioral), 2 (Primary Verbal), 3 (Corroborated Reviews/Threads), 4 (Secondary Reports), 5 (Unvalidated Hypothesis)."
    },
    "evidence_artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "File paths, URLs, or recorded quotes backing the claims."
    },
    "scores": {
      "type": "object",
      "required": [
        "frequency",
        "severity",
        "workaround",
        "track_dimension",
        "decision_maker",
        "feasibility",
        "discrepancy"
      ],
      "properties": {
        "frequency": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Problem recurrence: 0 (Annual/Rare) to 5 (Daily continuous)."
        },
        "severity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Financial loss, consequence, or penalty: 0 (Cosmetic) to 5 (Direct fines/loss)."
        },
        "workaround": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Existing workaround investment or inaction root cause: 0 (None) to 5 (Dedicated staff/macros)."
        },
        "track_dimension": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Track A: WTP ($29-$199/mo); Track B: Utility, Repeat Adoption & Time Saved."
        },
        "decision_maker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Adoption friction: 0 (Enterprise RFP) to 5 (Self-serve operator card / instant install)."
        },
        "feasibility": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Solo builder engineering feasibility: 0 (Deep hardware/frontier AI) to 5 (Lean micro-tool)."
        },
        "discrepancy": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Process discrepancy & handoff breakdown: 0 (Clean tool) to 5 (Acute multi-party breakdown)."
        }
      },
      "additionalProperties": false
    },
    "stop_checks": {
      "type": "object",
      "properties": {
        "infrequent_low_impact": { "type": "boolean", "default": false },
        "no_meaningful_workaround": { "type": "boolean", "default": false },
        "commercial_alternative_fits_well": { "type": "boolean", "default": false },
        "single_source_bias": { "type": "boolean", "default": false },
        "internal_training_issue": { "type": "boolean", "default": false },
        "unreachable_audience": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    },
    "workflow_14_nodes": {
      "type": "object",
      "properties": {
        "actor": { "type": "string" },
        "trigger": { "type": "string" },
        "input": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "decisions": { "type": "string" },
        "handoffs": { "type": "string" },
        "delays": { "type": "string" },
        "rework": { "type": "string" },
        "errors": { "type": "string" },
        "output": { "type": "string" },
        "cost": { "type": "string" },
        "risk": { "type": "string" },
        "audit": { "type": "string" }
      },
      "additionalProperties": false
    },
    "experiment_outcome": {
      "type": "object",
      "properties": {
        "hypothesis": { "type": "string" },
        "test_mechanism": { "type": "string" },
        "success_metric": { "type": "string" },
        "observed_result": { "type": "string" },
        "verified": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "smallest_suitable_solution": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "enum": ["template_sop", "static_web_utility", "cli_tool", "browser_extension", "micro_saas"]
        },
        "tool_name": { "type": "string" },
        "description": { "type": "string" },
        "distribution_channel": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
