{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentskills.io/schemas/problem-discovery/scoring-matrix.schema.json",
  "title": "Problem discovery candidate input",
  "description": "Research scores are not evidence of demand. This schema validates structure only; the CLI checks local-file digest integrity, and a human must review authenticity.",
  "type": "object",
  "required": ["id", "title", "domain", "track", "evidence_level", "scores"],
  "properties": {
    "id": {"type": "string", "minLength": 1, "maxLength": 120},
    "title": {"type": "string", "minLength": 5},
    "domain": {"type": "string", "minLength": 1},
    "track": {"enum": ["commercial", "free_utility"]},
    "evidence_level": {"type": "integer", "minimum": 1, "maximum": 5},
    "scores": {
      "type": "object",
      "required": ["frequency", "severity", "workaround", "decision_maker", "feasibility", "discrepancy"],
      "properties": {
        "frequency": {"$ref": "#/$defs/score"},
        "severity": {"$ref": "#/$defs/score"},
        "workaround": {"$ref": "#/$defs/score"},
        "wtp": {"$ref": "#/$defs/score"},
        "track_dimension": {"$ref": "#/$defs/score"},
        "utility_impact": {"$ref": "#/$defs/score"},
        "decision_maker": {"$ref": "#/$defs/score"},
        "feasibility": {"$ref": "#/$defs/score"},
        "discrepancy": {"$ref": "#/$defs/score"}
      },
      "anyOf": [{"required": ["wtp"]}, {"required": ["track_dimension"]}, {"required": ["utility_impact"]}],
      "additionalProperties": false
    },
    "stop_checks": {
      "type": "object",
      "properties": {
        "infrequent_low_impact": {"type": "boolean"},
        "no_meaningful_workaround": {"type": "boolean"},
        "commercial_alternative_fits_well": {"type": "boolean"},
        "single_source_bias": {"type": "boolean"},
        "internal_training_issue": {"type": "boolean"},
        "unreachable_audience": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "evidence_sources": {"type": "array", "items": {"type": "string"}},
    "evidence_artifacts": {"type": "array", "items": {"type": "string"}},
    "evidence_records": {
      "type": "array", "items": {
        "type": "object", "required": ["level", "claim", "observed_on", "artifact_path", "sha256", "reviewed_by", "reviewed_on"],
        "properties": {
          "level": {"enum": [1, 2]},
          "claim": {"type": "string", "minLength": 1},
          "observed_on": {"$ref": "#/$defs/date"},
          "artifact_path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/digest"},
          "reviewed_by": {"type": "string", "minLength": 1},
          "reviewed_on": {"$ref": "#/$defs/date"}
        },
        "additionalProperties": false
      }
    },
    "experiment": {
      "type": "object",
      "required": ["hypothesis", "metric", "failure_rule", "success_threshold", "observed_value", "direction", "sample_size", "preregistered_on", "started_on", "ended_on", "artifact_path", "sha256", "reviewed_by", "reviewed_on"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1},
        "failure_rule": {"type": "string", "minLength": 1},
        "success_threshold": {"type": "number"},
        "observed_value": {"type": "number"},
        "direction": {"enum": ["at_least", "at_most"]},
        "sample_size": {"type": "integer", "minimum": 1},
        "preregistered_on": {"$ref": "#/$defs/date"},
        "started_on": {"$ref": "#/$defs/date"},
        "ended_on": {"$ref": "#/$defs/date"},
        "artifact_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/digest"},
        "reviewed_by": {"type": "string", "minLength": 1},
        "reviewed_on": {"$ref": "#/$defs/date"}
      },
      "additionalProperties": false
    },
    "experiment_outcome": {"type": "string", "description": "Legacy prose is stored for compatibility but never counts as verification."},
    "solution_constraints": {
      "type": "object",
      "properties": {
        "non_software_sufficient": {"type": "boolean"},
        "needs_interactive_ui": {"type": "boolean"},
        "needs_batch_automation": {"type": "boolean"},
        "needs_browser_integration": {"type": "boolean"},
        "needs_multi_user_sync": {"type": "boolean"},
        "needs_server_storage": {"type": "boolean"},
        "needs_background_jobs": {"type": "boolean"},
        "offline_required": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "score": {"type": "integer", "minimum": 0, "maximum": 5},
    "date": {"type": "string", "format": "date"},
    "digest": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
  },
  "additionalProperties": false
}
